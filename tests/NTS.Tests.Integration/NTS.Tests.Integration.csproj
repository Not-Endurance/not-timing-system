<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nugets\Not\Not.csproj" />
    <ProjectReference Include="..\..\nugets\Not.Blazor\Not.Blazor.csproj" />
    <ProjectReference Include="..\..\nugets\Not.Identity\Not.Identity.csproj" />
    <ProjectReference Include="..\..\nugets\Not.Krud\Not.Krud.csproj" />
    <ProjectReference Include="..\..\nugets\Not.Test\Not.Test.csproj" />
    <ProjectReference Include="..\..\src\NoTiming.Api\NoTiming.Api.csproj" />
    <ProjectReference Include="..\..\src\NoTiming.Ui\NoTiming.Ui.csproj" />
    <ProjectReference Include="..\..\src\NTS.Contracts\NTS.Contracts.csproj" />
    <ProjectReference Include="..\..\tools\NTS.Tools\NTS.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.16.0" />
    <!--
      Testcontainers 4.11.0 brings SSH.NET 2025.1.0, which has two high-severity advisories (GHSA-q939-rpr3-3284 and
      GHSA-mggc-4xg6-vcxf). 2026.0.0 is the first version that clears both. Nothing here uses SSH.NET itself.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Parked scenarios, all in Parked\. Each of these needs a connected Judge or the hub write path (Receive), which the
    platform no longer has (#598, ADR-0011, ADR-0013). They are kept as they were written and are not compiled. Their
    assertions are edited only with the owner's approval per test (AGENTS.md rule 4, #642). See README.md, "Parked scenarios".
  -->
  <ItemGroup>
    <Compile Remove="Parked\**" />
  </ItemGroup>

  <!--
    A manual check, which no verification run includes: the budget of the Ui's first load publishes the Ui for Release, which
    takes about half a minute on an idle machine. It is compiled only when it is asked for, with -p:IncludeManualTests=true (see README.md).
  -->
  <ItemGroup Condition="'$(IncludeManualTests)' != 'true'">
    <Compile Remove="Ui\UiFirstLoadBudgetTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Not.Test" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
