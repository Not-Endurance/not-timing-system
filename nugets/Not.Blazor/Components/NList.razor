@namespace Not.Blazor.Components
@using Not.Blazor.Components.Input

@typeparam T
@inherits NListBehind<T>

<MudStack Row Class="mb-2">
    @if (Title != null)
    {
        <NHeadline3 Content="@Title" Class="pt-1"/>
    }

    @if (CanSearch)
    {
        <NAutocomplete T="T"
                    Class="ml-4 mr-4"
                    Value="@SearchValue"
                    ValueChanged="OnSearchValueChanged"
                    Text="@SearchText"
                    TextChanged="OnSearchTextChanged"
                    SearchSafe="SearchItemsSafe"
                    ToStringFunc="ItemToString"
                    Clearable
                    MaxItems="@((int?)null)"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    OnClearButtonClick="ClearSearch" />
    }
    else
    {
        <MudSpacer />
    }

    @if (CreateSafe != null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OnCreate" />
    }
</MudStack>

<MudStack Class="@ContainerClass">
    @if (IsLoading)
    {
        <NSkeleton />
    }
    else if (!VisibleItems.Any())
    {
        <MudText Typo="Typo.body1">@List_is_empty_string</MudText>
    }
    else
    {
        foreach (var item in VisibleItems)
        {
            <MudStack Row AlignItems="AlignItems.Center" Spacing="0" Class="border-solid" Style="border-bottom: 1px solid gray;">
                <MudText Typo="Typo.body1">@item</MudText>

                <MudSpacer />

                @if (ViewSafe != null && (CanView?.Invoke(item) ?? true))
                {
                    <NIconView OnClick="() => OnView(item)" Class="px-4 py-2" />
                }
                @if (UpdateSafe != null && (CanUpdate?.Invoke(item) ?? true))
                {
                    <NIconUpdate OnClick="() => OnUpdate(item)" Class="px-4 py-2" />
                }
                @if (DeleteSafe != null)
                {
                    <NIconDelete OnClick="() => OnDelete(item)" Class="px-4 py-2" />
                }
                @if (CustomAction1 != null)
                {
                    @CustomAction1(item)
                }
                @if (CustomAction2 != null)
                {
                    @CustomAction2(item)
                }
            </MudStack>
        }
    }
</MudStack>

<style>
    .n-list-scroll {
        max-height: 350px;
        overflow-y: auto;
    }
</style>
