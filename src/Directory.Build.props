<Project>
  
  <PropertyGroup>
   <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
   <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Pin transitive dependencies to patched versions (NuGet audit: GHSA-pgww-w46g-26qg, GHSA-6c8g-7p36-r338, GHSA-pggp-6c3x-2xmx, GHSA-mggc-4xg6-vcxf, GHSA-q939-rpr3-3284). -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.9.1" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
