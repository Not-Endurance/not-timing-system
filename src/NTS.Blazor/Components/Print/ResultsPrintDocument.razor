@using NTS.Blazor.Components.Results
@inherits ResultsPrintDocumentBehind

<div class="print-document print-document-results">
    <div class="results-print-backdrop" aria-hidden="true">
        <img src="@BackdropLogo" alt="" />
    </div>

    <div class="results-print-footer">
        @GeneratedByText
    </div>

    @foreach (var document in Documents)
    {
        <section class="@GetSectionClass()">
            <ResultsDocumentView Document="document"
                                 LeftLogo="@LeftLogo"
                                 RightLogo="@RightLogo"
                                 LogoClicked="@LogoClicked" />
        </section>
    }
</div>

<style>
    .results-print-backdrop,
    .results-print-footer {
        display: none;
    }

    .results-print-section {
        position: relative;
    }

    @@media print {
        .print-document-results {
            position: relative;
        }

        .results-print-backdrop {
            display: flex;
            position: fixed;
            inset: 0;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            z-index: 0;
        }

        .results-print-backdrop img {
            width: min(70vw, 680px);
            max-height: 70vh;
            opacity: 0.04;
        }

        .results-print-section {
            padding-bottom: 4mm;
            z-index: 1;
        }

        .results-print-footer {
            display: block;
            position: fixed;
            right: 7mm;
            bottom: 5mm;
            z-index: 2;
            color: #202020;
            font-size: 8px;
            line-height: 1;
        }
    }
</style>
