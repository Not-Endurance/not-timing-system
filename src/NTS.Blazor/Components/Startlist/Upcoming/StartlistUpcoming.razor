@using NTS.Domain.Core.Objects
@using NTS.Domain.Core.Objects.Startlists
@using MudBlazor

@inherits StartlistUpcomingBehind

@if (Service.Upcoming.Count != 0)
{
    <MudTable T="Starter"
              Items="Service.Upcoming"
              Breakpoint="Breakpoint.Xs"
              Dense="true"
              Hover="true"
              Elevation="0"
              Class="@($"startlist-table {Class}")">

        <ColGroup>
            <col class="startlist-col-number" />
            <col class="startlist-col-timer" />
            <col class="startlist-col-athlete" />
            <col class="startlist-col-gate" />
        </ColGroup>

        <HeaderContent>
            <MudTh>@Number_string</MudTh>
            <MudTh>@Start_In_string</MudTh>
            <MudTh>@Athlete_string</MudTh>
            <MudTh>@GateHeader</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd DataLabel="@Number_string" Class="startlist-number-cell">
                <MudText Typo="Typo.body2">#@context.Number</MudText>
            </MudTd>

            <MudTd DataLabel="@Start_In_string" Class="startlist-time-cell">
                <StartlistEntryTimer @key="GetTimerKey(context)" Entry="context" />
            </MudTd>

            <MudTd DataLabel="@Athlete_string" Class="startlist-athlete-cell">
                <MudText Typo="Typo.caption">
                    <span class="startlist-athlete-text" title="@FormatAthlete(context)">
                        @FormatAthlete(context)
                    </span>
                </MudText>
            </MudTd>

            <MudTd DataLabel="@GateHeader" Class="startlist-gate-cell">
                <MudText Typo="Typo.caption" Class="startlist-gate-text">@context.Gate</MudText>
            </MudTd>

        </RowTemplate>

    </MudTable>
}
