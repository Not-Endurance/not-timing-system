@inherits ResultComponentBehind

@{
    if (Document == null)
    {
        return;
    }
}

<div class="print-document print-document-results">
    <section class="@SectionClass">
        <ResultHeaderComponent Header="Document.Header"
                               LeftLogo="@LeftLogo"
                               RightLogo="@RightLogo"
                               LogoClicked="@LogoClicked" />

        <MudStack Spacing="0" AlignItems="AlignItems.Center">
            @foreach (var entry in Document.Entries)
            {
                <div class="results-entry print-avoid-break">
                    <ParticipationResultComponent Entry="entry" />
                </div>
            }
        </MudStack>
    </section>
</div>

<style>
    .results-entry {
        width: 100%;
    }

    h6,
    .participation-table .mud-button-label {
        font-weight: normal !important;
    }
</style>
