@using NTS.Blazor.Components.ParticipationTable
@using NTS.Domain.Core.Objects.Documents
@using static Not.Localization.LocalizationHelper

<div class="print-document print-document-handouts">
    @foreach (var document in Documents)
    {
        var header = document.Header;
        <section class="handout-print-page print-avoid-break">
            <div class="d-flex flex-row">
                <div class="mr-4">
                    <MudStack Style="height:100%; max-width:300px">
                        <NHeadline2 Content="@header.Title" />
                        <NHeadline3 Content="@($"{header.Location} {header.EventSpan} {LocalizeString(header.Country.ToString())}")" />

                        <MudDivider Style="flex-grow:0;" />
                        @if (header.GroundJuryPresident != null)
                        {
                            <MudText Typo="Typo.body2">@header.GroundJuryPresident.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        @if (header.VeterinaryCommissionPresident != null)
                        {
                            <MudText Typo="Typo.body2">@header.VeterinaryCommissionPresident.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        @if (header.ForeignJudge != null)
                        {
                            <MudText Typo="Typo.body2">@header.ForeignJudge.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        @if (header.ForeignVeterinaryDelegate != null)
                        {
                            <MudText Typo="Typo.body2">@header.ForeignVeterinaryDelegate.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        @if (header.TechnicalDelegate != null)
                        {
                            <MudText Typo="Typo.body2">@header.TechnicalDelegate.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        @if (header.ChiefSteward != null)
                        {
                            <MudText Typo="Typo.body2">@header.ChiefSteward.GetDisplayLabel(header.Ruleset)</MudText>
                        }
                        <MudSpacer />

                        <div class="d-flex flex-row justify-center">
                            <MudImage Class="pb-5" Height="150" Width="135" Src="images/logos/logo-fei.png" />
                            <MudImage Height="115" Width="135" Src="images/logos/logo-bfks.png" />
                        </div>
                    </MudStack>
                </div>

                <div>
                    <MudText Typo="Typo.h5">@document.Combination.GetDisplayName(header.Ruleset)</MudText>
                    <ParticipationTable Phases="document.Phases" Number="document.Combination.Number" />
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<HandoutDocument> Documents { get; set; } = [];
}
