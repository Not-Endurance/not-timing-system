@using NTS.Judge.Blazor.Layout
@layout PrintLayout
@attribute [Route(PRINT_HANDOUTS_PAGE)]
@inherits HandoutsPrintPageBehind

@if (ErrorMessage != null)
{
    <div data-print-error>@ErrorMessage</div>
}
else if (IsReady)
{
    <div data-print-ready="true">
        <PrintDocumentStyles PaperFormat="PaperFormat"
                             Orientation="Orientation"
                             FontScale="FontScale"
                             Margin="6mm" />
        <HandoutsPrintDocument Documents="Documents" />
    </div>
}
