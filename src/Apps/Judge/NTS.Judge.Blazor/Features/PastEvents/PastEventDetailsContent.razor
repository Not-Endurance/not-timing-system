@using Not.Blazor.Components.Layout
@using Not.Blazor.Components.Input
@using NTS.Application.Contracts.Pdf
@using NTS.Blazor.Components.Rankings.Menu
@using NTS.Blazor.Components.Rankings.Protocols

@attribute [Route(PAST_EVENT_DETAILS_PAGE)]
@inherits PastEventDetailsContentBehind

<NContent Title="@Past_events_string" IsLoading="@IsLoading" IsEmpty="@IsEmpty">
    <Main>
        <Protocol Document="Service.Document" />
    </Main>

    <Rightbar>
        <MudStack Spacing="3">
            <MudStack Row AlignItems="AlignItems.Center">
                <NSelect T="PdfResultAction"
                         @bind-Value="ResultAction"
                         Label="@Action_string"
                         Style="min-width:180px" />

                <NButtonSecondary OnClick="RunResultAction"
                                  Text="@ResultActionText"
                                  StartIcon="@ResultActionIcon"
                                  Disabled="@(!CanRunResultAction)" />
            </MudStack>

            <NButtonSecondary OnClick="OpenStartlist"
                              Text="@Startlist_string"
                              StartIcon="@Icons.Material.Filled.List"
                              Disabled="@(!HasStartlist)" />

            <NButtonPrimary OnClick="GenerateFeiExport"
                            Text="@Export_FEI_string"
                            StartIcon="@Icons.Material.Filled.ImportExport"
                            Disabled="@(!HasFeiExportConfigured)" />

            <RankingMenu Rankings="Service.Rankings"
                         Selected="Service.CurrentRanking"
                         OnSelectedSafe="SelectRanking" />
        </MudStack>
    </Rightbar>
</NContent>
