@using NTS.Blazor.Components.Rankings.Menu
@using NTS.Blazor.Components.Rankings.Protocols
@using Not.Blazor.Components.Input
@using Not.Blazor.Components.Layout
@using NTS.Application.Contracts.Pdf

@attribute [Route(RANKLIST_PAGE)]
@inherits RankingsContentBehind

<NContent Title="@Ranklist_string" IsLoading="@IsLoading" Class="@Class">

    <Main>
        <Protocol Document="Document"
                  Compact="false"
                  LeftLogo="@HeaderLogo.Left"
                  RightLogo="@HeaderLogo.Right"
                  LogoClicked="OpenImageBrowser" />
    </Main>

    <Rightbar>
        <MudStack Row Wrap="Wrap.Wrap">
            <MudStack Row AlignItems="AlignItems.Center">
                <NSelect T="PdfResultAction"
                         @bind-Value="ResultAction"
                         Label="@Action_string"
                         Style="min-width:180px" />

                <NButtonSecondary OnClick="RunResultAction"
                                  Text="@ResultActionText"
                                  StartIcon="@ResultActionIcon"
                                  Disabled="@(!CanRunResultAction)" />
            </MudStack>

            <NButtonSecondary OnClick="OpenCustomRankingDialog" Text="@Custom_ranking_string" StartIcon="@Icons.Material.Filled.Add"/>

            @if (HasActiveEvent)
            {
                <NButtonWarning
                    Text="@Deactivate_Event_string"
                    OnClick="OpenDeactivateEventDialog"
                    StartIcon="@Icons.Material.Filled.EventBusy" />
            }
        </MudStack>

        @if (!IsDeactivatingEvent)
        {
            <RankingMenu Rankings="RankingService.Rankings"
                         Selected="RankingService.Current"
                         OnSelectedSafe="SelectRanking"
                         OnDeleteSafe="OpenDeleteDialog"
                         Class="mt-4" />
        }
    </Rightbar>

</NContent>
