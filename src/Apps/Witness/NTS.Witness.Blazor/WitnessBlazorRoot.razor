@using NTS.Witness.Blazor.Layout
@using NTS.Witness.Blazor.Features.Profile
@using Not.Blazor.Client.Authentication.Components
@using Not.Blazor.Components.Exceptions

@inherits WitnessBlazorRootBehind

<NExceptionHandlerErrorBoundary>
    <ChildContent>
        <CascadingAuthenticationState>
            <Router AppAssembly="@Assembly" AdditionalAssemblies="@RouteAssemblies">

                <Found Context="routeData">

                    <ProfileRouteGate RouteData="@routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized>
                                <AuthenticateContent />
                            </NotAuthorized>
                        </AuthorizeRouteView>
                    </ProfileRouteGate>

                    <FocusOnNavigate RouteData="@routeData" Selector=".n-route-focus-target" />

                </Found>

                <NotFound>

                    <LayoutView Layout="@typeof(MainLayout)">
                        <p role="alert">@Sorry_theres_nothing_at_this_address_string</p>
                    </LayoutView>

                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </ChildContent>

    <ErrorContent>
        <LayoutView Layout="@typeof(MainLayout)">
            <NExceptionHandlerContent />
        </LayoutView>
    </ErrorContent>
</NExceptionHandlerErrorBoundary>
