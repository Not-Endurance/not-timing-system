@using NC.Blazor.Components.Layout
@using NC.Blazor.Components.Print
@using NoTiming.Blazor.Components.Rankings.Menu
@using NoTiming.Blazor.Components.Results

@attribute [Route(PAST_EVENT_DETAILS_PAGE)]
@inherits JudgePastEventDetailsContentBehind

<NContent Title="@Past_events_string" IsLoading="@IsLoading" IsEmpty="@IsEmpty">
    <Main>
        @if (Document != null)
        {
            <ResultComponent Document="Document" />
        }
    </Main>

    <Rightbar>
        <MudStack Spacing="3">
            <NPrintPanel @bind-Scale="PrintFontScale"
                         Actions="@ResultActions"
                         Disabled="@(!CanRunResultAction)" />

            <NButtonSecondary OnClick="OpenStartlist"
                              Text="@Startlist_string"
                              StartIcon="@Icons.Material.Filled.List"
                              Disabled="@(!HasStartlist)" />

            <NButtonPrimary OnClick="GenerateFeiExport"
                            Text="@Export_FEI_string"
                            StartIcon="@Icons.Material.Filled.ImportExport"
                            Disabled="@(!HasFeiExportConfigured)" />

            <RankingMenu Rankings="Rankings"
                         Selected="CurrentRanking"
                         OnSelectedSafe="SelectRankingSafe" />
        </MudStack>
    </Rightbar>
</NContent>
