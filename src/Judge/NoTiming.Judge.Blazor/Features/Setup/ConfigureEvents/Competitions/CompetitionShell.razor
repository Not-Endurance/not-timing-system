@using NoTiming.Judge.Contracts.Features.Setup.ConfigureEvents.Competitions
@using NC.Blazor.Components.Input
@using NC.Krud.Blazor.Components

@inherits CompetitionShellBehind

<KrudForm Shell="this" AdditionalContent="AdditionalContent">

    <FormFields>
        <NTextField @bind-Value="Model.Name" For="() => Model.Name" Label="@Name_string" />

        <NSwitch @bind-Value="Model.EnglishNames" For="() => Model.EnglishNames" Label="@English_names_string" />

        <NDatePicker @bind-Date="Model.Date" For="() => Model.Date" Label="@Date_string" ImmediateText="true"/>

        <NTimePicker @bind-Time="Model.Time" For="() => Model.Time" Label="@Time_string" ImmediateText="true" Editable="true" Mask="TimeMask" />

        <NSwitch @bind-Value="Model.UseCompulsoryThreshold" For="() => Model.UseCompulsoryThreshold" Label="@Automatic_CRI_string" />

        @if (Model.UseCompulsoryThreshold)
        {
            <NNumberField @bind-Value="Model.CompulsoryThresholdMinutes" For="() => Model.CompulsoryThresholdMinutes" />
        }

        <NNumberField @bind-Value="Model.LoopSpeedMin" For="() => Model.LoopSpeedMin" Label="@Loop_speed_min_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.LoopSpeedMax" For="() => Model.LoopSpeedMax" Label="@Loop_speed_max_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.PhaseSpeedMin" For="() => Model.PhaseSpeedMin" Label="@Phase_speed_min_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.PhaseSpeedMax" For="() => Model.PhaseSpeedMax" Label="@Phase_speed_max_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.LoopAverageSpeedMin" For="() => Model.LoopAverageSpeedMin" Label="@Loop_average_speed_min_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.LoopAverageSpeedMax" For="() => Model.LoopAverageSpeedMax" Label="@Loop_average_speed_max_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.PhaseAverageSpeedMin" For="() => Model.PhaseAverageSpeedMin" Label="@Phase_average_speed_min_string" HelperText="@Speed_limits_combine_helper_string" />
        <NNumberField @bind-Value="Model.PhaseAverageSpeedMax" For="() => Model.PhaseAverageSpeedMax" Label="@Phase_average_speed_max_string" HelperText="@Speed_limits_combine_helper_string" />

        <NParagraph Content="@Locate_FEI_Show_data_instructions_string" Class="mt-8 mb-2" />

        <NTextField @bind-Value="Model.FeiEventId" For="() => Model.FeiEventId" Label="@FEI_Event_ID_string" HelperText="@FEI_Event_ID_helper_text_string" />

        <NTextField @bind-Value="Model.FeiEventCode" For="() => Model.FeiEventCode" Label="@FEI_Event_Code_string" HelperText="@FEI_Event_Code_helper_text_string" />

        <NTextField @bind-Value="Model.FeiCompetitionId" For="() => Model.FeiCompetitionId" Label="@FEI_Competition_ID_string" HelperText="@FEI_Competition_ID_helper_text_string" />

        <NTextField @bind-Value="Model.FeiRule" For="() => Model.FeiRule" Label="@FEI_Rule_string" HelperText="@FEI_Rule_helper_text_string" />

        <NTextField @bind-Value="Model.FeiScheduleNumber" For="() => Model.FeiScheduleNumber" Label="@FEI_Schedule_Number_string" HelperText="@FEI_Schedule_Number_helper_text_string"/>
    </FormFields>

</KrudForm>
