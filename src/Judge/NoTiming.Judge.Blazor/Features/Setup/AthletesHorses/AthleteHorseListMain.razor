@using NoTiming.Domain.Setup.Aggregates
@using NoTiming.Judge.Blazor.Features.Setup.AthletesHorses.Athletes
@using NoTiming.Judge.Blazor.Features.Setup.AthletesHorses.Horses
@using NoTiming.Judge.Contracts.Features.Setup.Athletes
@using NoTiming.Judge.Contracts.Features.Setup.Horses
@using NC.Blazor.Components.Layout
@using NC.Krud.Blazor
@using NC.Krud.Blazor.Components

@attribute [Route(ATHLETES_HORSES_PAGE)]
@inherits AthleteHorseListMainBehind

<NContent Title="@Athletes_and_Horses_string">

    <Main>
        <MudGrid Spacing="8" Style="margin-top:0!important;">
            <MudItem xs="6">
                <KrudList T="Athlete" TShell="AthleteShell" TModel="AthleteFormModel" Name="@Athletes_string" AllowCreate AllowUpdate AllowDelete NoScroll />
            </MudItem>
            
            <MudItem xs="6">
                <KrudList T="Horse" TShell="HorseShell" TModel="HorseFormModel" Name="@Horses_string" AllowCreate AllowUpdate AllowDelete NoScroll />
            </MudItem>
        </MudGrid>
    </Main>

</NContent>
