@using Not.Blazor.Components.Input
@using Not.Krud.Blazor.Components

@inherits HorseShellBehind

<KrudForm Shell="this" AdditionalContent="AdditionalContent" DisableBack>
    <FormFields>
        <NTextField @bind-Value="Model.Name" For="() => Model.Name" Label="@Name_string" />

        <NTextField @bind-Value="Model.NameEnglish" For="() => Model.NameEnglish" Label="@Name_in_English_string" />

        <NTextField @bind-Value="Model.FeiId" For="() => Model.FeiId" Label="@FEI_ID_string" />
    </FormFields>
</KrudForm>
