@using NTS.Domain.Setup.Services.StartValidation

@inherits StartIssuesDialogBehind

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@Start_validation_invalid_setup_description_string</MudText>

        @foreach (var issue in Issues)
        {
            <MudPaper Class="pa-3 mb-2" Outlined data-testid="console-start-issue">
                <MudText Typo="Typo.body1">@issue.Summary</MudText>

                @if (issue.IsAutoCorrectable)
                {
                    var number = issue.ParticipationNumber!.Value;

                    <MudText Typo="Typo.caption" Class="d-block mt-1">@Start_validation_issue_explanation_string</MudText>

                    <MudRadioGroup T="Guid?" Value="StaysIn(number)" ValueChanged="@(x => Choose(number, x))" Class="mt-2">
                        @foreach (var competition in issue.Competitions)
                        {
                            <MudRadio Size="MudBlazor.Size.Small" T="Guid?" Value="@((Guid?)competition.CompetitionId)">
                                @string.Format(Remove_from__string, $"{competition.CompetitionName} ({competition.PhaseSignature})")
                            </MudRadio>
                        }
                    </MudRadioGroup>
                }
            </MudPaper>
        }
    </DialogContent>

    <DialogActions>
        @if (HasCorrections)
        {
            <NButtonPrimary Text="@Start_string" Disabled="@(!CanApplyCorrections)" OnClick="Correct" />
        }

        <NButtonSecondary Text="@Close_string" OnClick="CancelDialog" />
    </DialogActions>
</MudDialog>
