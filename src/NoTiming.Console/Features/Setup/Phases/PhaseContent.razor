@attribute [Route(PHASE_PAGE)]
@inherits PhaseContentBehind

<NContent Title="@Configure_Phase_string" IsEmpty="Model == null">

    <Main>
        <MudStack Spacing="4">

            <MudStack Row Justify="Justify.FlexStart">
                <NButtonBack OnClick="@(() => GoBack())" />
            </MudStack>

            <PhaseShell Model="Model" ReadOnly="@ReadOnly" />
        </MudStack>
    </Main>

</NContent>
