@using NoTiming.Console.Features.Dashboard.Eliminations
@using NoTiming.Ui.Components.ParticipationChips
@using NoTiming.Ui.Components.ParticipationTable
@using NTS.Domain.Core.Aggregates
@using Not.Blazor.Components.Input

@inherits DashboardPageBehind

<NContent Title="@Dashboard_string" IsLoading="@IsLoading" IsEmpty="@(!IsLoading && Participations.Count == 0)">

    <Main>
        @if (Selected != null)
        {
            <NGrid>
                <MudItem xs="12" Class="mb-4">
                    <NAutocomplete T="Participation"
                                   @key="Selected.Combination.Number"
                                   @bind-Value="Selected"
                                   TextUpdateSuppression="false"
                                   SearchSafe="Search"
                                   Class="mb-2 dashboard-autocomplete" />
                </MudItem>

                <MudItem xs="3">
                    <ParticipationChips Participations="@Participations"
                                        RecentlyTimed="@RecentlyTimed"
                                        @bind-Selected="Selected" />
                </MudItem>

                <MudItem xs="9">
                    <ParticipationTable Phases="@Selected.Phases"
                                        Number="@Selected.Combination.Number"
                                        Vertical
                                        Editable />
                </MudItem>
            </NGrid>
        }
    </Main>

    <Rightbar>
        @if (Selected != null)
        {
            <TimePanel Class="mb-2" />

            <RequestsPanel Class="mb-2" />

            <EliminationsPanel Class="mb-2" />
        }
    </Rightbar>

</NContent>

<style>
    .dashboard-autocomplete .mud-select-input {
        margin-top: 0 !important;
    }
    .dashboard-autocomplete input {
        font-size: 1.5rem !important;
    }
    .dashboard-autocomplete label {
        font-size: 1.25rem !important;
    }
</style>
