@using NoTiming.Ui.Components.EventViews
@using NTS.Domain.Access

@attribute [Route(EVENT_DASHBOARD_PAGE)]
@inherits DashboardContentBehind

<EventNavigation EventId="EventId" Current="@EVENT_DASHBOARD_PAGE" />

@if (IsLoading || !MayRun)
{
    <NContent Title="@Dashboard_string" IsLoading="@IsLoading" IsEmpty="@(!IsLoading)" EmptyMessage="@Event_not_yours_to_run_string" />
}
else
{
    <ViewedEventScope EventId="EventId" Shows="CoreView.Dashboard">
        <DashboardPage />
    </ViewedEventScope>
}
