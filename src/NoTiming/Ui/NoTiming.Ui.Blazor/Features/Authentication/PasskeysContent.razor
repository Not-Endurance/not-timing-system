@using MudBlazor
@using NC.Blazor.Components.Buttons
@using NC.Blazor.Components.Input
@using NC.Blazor.Components.Layout

@attribute [Route(PASSKEYS_PAGE)]
@inherits PasskeysContentBehind

<div class="narrow-page">
    <NContent Title="@Passkeys_string">
        <Main>
            <MudStack Spacing="3">
                @if (NotSignedIn)
                {
                    <MudText>@Sign_in_to_manage_passkeys_string</MudText>
                    <NButtonPrimary Text="@Sign_in_string" Size="Size.Large" Style="width:100%" OnClick="GoToLogin" />
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        @Passkey_explanation_string
                    </MudText>

                    @foreach (var passkey in Passkeys)
                    {
                        <MudPaper Class="pa-3">
                            <MudStack Spacing="2">
                                @if (Renaming == passkey.Id)
                                {
                                    <NTextField @bind-Value="NewName" For="() => NewName" Label="@Description_string" HelperText="@Description_hint_string" Required />
                                    <MudStack Row Spacing="2">
                                        <NButtonPrimary Text="@Save_string" OnClick="() => RenameSafe(passkey.Id)" />
                                        <NButtonCancel Text="@Cancel_string" OnClick="CancelRename" />
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText><strong>@passkey.Name</strong> — @string.Format(Added_on_string, passkey.CreatedAt.ToString("yyyy-MM-dd"))</MudText>
                                    <MudText Typo="Typo.body2">@(passkey.LastUsedAt is { } usedAt ? string.Format(Last_used_string, usedAt.ToString("yyyy-MM-dd")) : Never_used_string)</MudText>
                                    <MudStack Row Spacing="2">
                                        <NButtonSecondary Text="@Rename_string" OnClick="() => StartRename(passkey)" />
                                        <NButtonDanger Text="@Remove_string" OnClick="() => RemoveSafe(passkey.Id)" />
                                    </MudStack>
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <NTextField @bind-Value="NewPasskeyName" For="() => NewPasskeyName" Label="@Description_string" HelperText="@Description_hint_string" Required />
                    <NButtonPrimary Text="@Add_passkey_to_device_string" Size="Size.Large" Style="width:100%" OnClick="AddPasskeySafe" />
                }

                @if (Message != null)
                {
                    <MudText Color="Color.Error" role="alert">@Message</MudText>
                }
            </MudStack>
        </Main>
    </NContent>
</div>
