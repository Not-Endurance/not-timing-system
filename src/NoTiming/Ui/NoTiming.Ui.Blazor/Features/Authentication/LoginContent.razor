@using MudBlazor
@using NC.Blazor.Components.Buttons
@using NC.Blazor.Components.Layout

@attribute [Route(NC.Blazor.Client.Authentication.AuthenticationContents.AUTHENTICATION)]
@inherits LoginContentBehind

<div class="narrow-page">
    <NContent Title="@Sign_in_string">
        <Main>
            <MudStack Spacing="3">
                <NButtonPrimary Text="@Sign_in_with_passkey_string" Size="Size.Large" Style="width:100%" OnClick="LoginWithPasskeySafe" />
                <NButtonSecondary Text="@Sign_in_with_code_string" Size="Size.Large" Style="width:100%" OnClick="OpenEmailLogin" />
                <NButtonPrimary Text="@Create_an_account_string" Size="Size.Large" Style="width:100%" OnClick="OpenRegister" />

                @if (Message != null)
                {
                    <MudText Color="Color.Error" role="alert">@Message</MudText>
                }
            </MudStack>
        </Main>
    </NContent>
</div>
