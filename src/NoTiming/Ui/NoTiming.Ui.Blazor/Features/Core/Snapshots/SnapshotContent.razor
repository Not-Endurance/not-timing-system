@using NoTiming.Blazor.Components.ParticipationChips
@using NoTiming.Ui.Blazor.Features.Core.Snapshots.Components
@using MudBlazor
@using NC.Blazor.Components.Buttons
@using NC.Blazor.Components.Layout

@attribute [Route(SNAPSHOT_PAGE)]
@attribute [Authorize]
@inherits SnapshotContentBehind

<NContent Title="@Snapshot_page_string">

    <Main>
        <MudStack Spacing="4">

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <SnapshotComponent Snapshots="@Snapshots" />
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <SnapshotComponent Snapshots="@Snapshots"
                                   Compact />
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <ParticipationChips Participations="@Participations"
                                    SelectedChanged="@MoveToSnapshot" />
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <ParticipationChips Participations="@Participations"
                                    SelectedChanged="@MoveToSnapshot"
                                    Compact />
            </MudHidden>

        </MudStack>
    </Main>

    <Main2>
        <SnapshotHistory />
    </Main2>

    <Rightbar>
        <NDropdownButton Descriptors="@PublishDescriptors"
                         Disabled="CapturedSnapshotsCount == 0"
                         MaxWidth />
    </Rightbar>

</NContent>
