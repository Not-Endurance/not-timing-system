<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nugets\Not.Server\Not.Server.csproj" />
    <ProjectReference Include="..\..\nugets\Not.Storage\Not.Storage.csproj" />
    <ProjectReference Include="..\Shared\NTS.Application\NTS.Application.csproj" />
    <ProjectReference Include="..\Apps\NoTiming.EventBus.Contracts\NTS.Nexus.Warp.Contracts.csproj" />
    <ProjectReference Include="..\Apps\Ui\NoTiming.Ui.Contracts\NTS.Witness.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <!--
    Local Debug runs: publish the Witness UI to obj/witness-ui/wwwroot. It is deliberately not copied into this
    project's wwwroot, because static web asset discovery then fails on duplicate Razor library assets.
    Development launch settings point WITNESS_UI_PATH at that folder.
  -->
  <PropertyGroup>
    <WitnessUiPublishDir>$(BaseIntermediateOutputPath)witness-ui/</WitnessUiPublishDir>
  </PropertyGroup>

  <Target Name="PublishWitnessUiForLocalRun" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)/../Apps/Ui/NoTiming.Ui/NTS.Witness.Web.csproj"
      Targets="Publish"
      Properties="Configuration=Debug;PublishDir=$(MSBuildProjectDirectory)/$(WitnessUiPublishDir);BlazorEnableCompression=false"
    />
  </Target>

</Project>
