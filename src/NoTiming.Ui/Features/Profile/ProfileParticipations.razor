@using NoTiming.Ui.Features.Participants
@using NTS.Contracts.Features.Participants

@inherits ProfileParticipationsBehind

<MudStack Spacing="3" data-testid="profile-participations">
    <MudText Typo="Typo.h6">@Participations_string</MudText>

    @if (Athlete == null)
    {
        <ParticipantPicker Label="@My_Athlete_string"
                           HelperText="@My_Athlete_helper_string"
                           Kind="ParticipantKind.Athlete"
                           ClearOnChosen="true"
                           OnChosen="LinkAthlete" />
    }
    else
    {
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.caption">@My_Athlete_string</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" data-testid="my-athlete">@Athlete.DisplayName</MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           aria-label="@RemoveText(Athlete)"
                           OnClick="UnlinkAthlete" />
        </MudStack>

        <ParticipationHistoryList Kind="ParticipantKind.Athlete" Id="Athlete.Id" />
    }

    <MudText Typo="Typo.h6">@Horses_string</MudText>
    <MudText Typo="Typo.caption">@Horses_helper_string</MudText>

    <MudStack Row Wrap="Wrap.Wrap" Spacing="2" data-testid="my-horses">
        @foreach (var shown in Horses)
        {
            <MudStack Row AlignItems="AlignItems.Center" Spacing="0" @key="shown.Horse.Id">
                <MudChip T="string" Size="Size.Small" OnClick="() => Open(shown.Horse)" data-testid="my-horse">@shown.Horse.DisplayName</MudChip>

                @if (shown.IsRemovable)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   aria-label="@RemoveText(shown.Horse)"
                                   OnClick="() => RemoveHorse(shown.Horse)" />
                }
            </MudStack>
        }
    </MudStack>

    <ParticipantPicker Label="@Add_a_Horse_string"
                       Kind="ParticipantKind.Horse"
                       ClearOnChosen="true"
                       OnChosen="AddHorse" />
</MudStack>
