@using Not.Blazor.Components.Layout
@using NoTiming.Ui.Components.Rankings.Menu
@using NoTiming.Ui.Components.Results

@attribute [Route(HISTORIC_EVENT_DETAILS_PAGE)]
@inherits HistoricEventDetailsContentBehind

<NContent Title="@Historic_events_string" IsLoading="@IsLoading" IsEmpty="@IsEmpty">
    <Main>
        @if (Document != null)
        {
            <ResultComponent Document="Document" />
        }
    </Main>

    <Rightbar>
        <MudStack Spacing="3">
            <NButtonSecondary OnClick="OpenStartlist"
                              Text="@Startlist_string"
                              StartIcon="@Icons.Material.Filled.List"
                              Disabled="@(!HasStartlist)" />

            <RankingMenu Rankings="Rankings"
                         Selected="CurrentRanking"
                         OnSelectedSafe="SelectRanking" />
        </MudStack>
    </Rightbar>
</NContent>
