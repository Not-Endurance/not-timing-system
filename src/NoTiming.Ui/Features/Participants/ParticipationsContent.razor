@using Not.Blazor.Components.Input
@using Not.Blazor.Components.Layout
@using NTS.Contracts.Features.Participants

@attribute [Route(PARTICIPATIONS_PAGE)]
@inherits ParticipationsContentBehind

<NContent Title="@Participations_string">
    <Main>
        <MudStack Spacing="3">
            <NTextField T="string"
                        Label="@Name_of_an_Athlete_or_a_Horse_string"
                        Value="Text"
                        ValueChanged="TextChanged"
                        Immediate="true"
                        DebounceInterval="PauseMilliseconds"
                        Clearable="true" />

            <ParticipantMatches Kind="ParticipantKind.Athlete" Text="@Text" OnChosen="Choose" />
            <ParticipantMatches Kind="ParticipantKind.Horse" Text="@Text" OnChosen="Choose" />

            @if (Chosen != null)
            {
                <MudText Typo="Typo.h6" data-testid="chosen-participant">@Chosen.DisplayName <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary">@KindText</MudText></MudText>
                <ParticipationHistoryList Kind="Chosen.Kind" Id="Chosen.Id" />
            }
        </MudStack>
    </Main>
</NContent>
